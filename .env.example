# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=science.cancercenter.uz,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://science.cancercenter.uz

# ---- Locale ----
LANGUAGE_CODE=uz
TIME_ZONE=Asia/Tashkent

# ---- PostgreSQL ----
# Agar DB_NAME bo'sh bo'lsa, lokal development uchun SQLite ishlatiladi.
DB_NAME=oncoscience
DB_USER=oncoscience
DB_PASSWORD=strong-password
DB_HOST=localhost
DB_PORT=5432

# ---- SEO / Open Graph ----
SITE_DOMAIN=https://science.cancercenter.uz
SITE_NAME=Oncoscience

# ---- CORS (asosiy cancercenter.uz sayti API'ni iste'mol qilishi uchun) ----
CORS_ALLOWED_ORIGINS=https://cancercenter.uz,https://www.cancercenter.uz
CORS_ALLOW_ALL_ORIGINS=False

# ---- Security (production) ----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
