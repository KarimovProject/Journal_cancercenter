# /etc/systemd/system/oncoscience.service
# systemctl daemon-reload && systemctl enable --now oncoscience
[Unit]
Description=Oncoscience (Gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/oncoscience
EnvironmentFile=/var/www/oncoscience/.env
ExecStart=/var/www/oncoscience/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/oncoscience.sock \
    oncoscience.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
